{
  "version": "v1",
  "hooks": [
    {
      "name": "Run related tests on save",
      "trigger": "PostFileSave",
      "description": "Runs only the unit tests related to the saved source, script, test or locale file",
      "matcher": "(^|[\\\\/])((src|tests)[\\\\/].*\\.(ts|tsx)|scripts[\\\\/].*\\.cjs|src[\\\\/]packs[\\\\/]language[\\\\/]locales[\\\\/][^\\\\/]+\\.json)$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/test-on-save.cjs",
        "timeout": 120
      }
    }
  ]
}