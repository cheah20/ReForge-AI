{
  "version": "v1",
  "hooks": [
    {
      "name": "Run related tests on save",
      "trigger": "PostFileSave",
      "description": "Runs only the unit tests related to the saved source or test file",
      "matcher": "(^|[\\\\/])(src|tests)[\\\\/].*\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/test-on-save.cjs",
        "timeout": 120
      }
    }
  ]
}