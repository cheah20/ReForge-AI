{
  // Wrangler configuration for ReForge AI
  // Use JSONC format as recommended by decision 15
  "name": "reforge-ai",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-09",

  // AI binding — remote: true required for local dev (no local simulation)
  "ai": {
    "binding": "AI"
  },

  // Rate limiting binding (per-IP, 10 requests per 60 seconds)
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],

  // SPA routing: API routes run worker first, everything else serves SPA
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },

  // Observability: log only operational metadata, never request/response bodies
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
