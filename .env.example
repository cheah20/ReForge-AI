# ReForge AI environment variables
# Copy this file to .env and fill in values as needed.
# Never commit .env to the repository.

# Cloudflare credentials (for wrangler deploy)
# CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
# CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>

# Workers AI is accessed via the Workers AI binding (env.AI),
# not via an API key. No AI_API_KEY is needed here.

# Development mode flag — set to "mock" to force MockAiProvider in dev
# AI_PROVIDER=mock
