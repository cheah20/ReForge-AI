{
  "name": "reforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ReForge AI — AI-Powered Legacy Web Modernization and Multilingual Form Assistance",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks || exit 0",
    "build:legacy": "tsx scripts/build-legacy-templates.ts",
    "copy-ocr-assets": "tsx scripts/copy-ocr-assets.ts",
    "predev": "npm run build:legacy && npm run copy-ocr-assets",
    "dev": "vite",
    "prebuild": "npm run build:legacy && npm run copy-ocr-assets",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --var AI_MODE:real",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:cpu": "vitest run --config vitest.cpu.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "generate-fixtures": "tsx scripts/create-fixtures/create-fixtures.ts",
    "generate-encrypted-fixture": "tsx scripts/create-fixtures/encrypted.ts",
    "generate-fixture-cache": "tsx scripts/generate-fixture-cache.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/msa": "1.0.0",
    "libphonenumber-js": "1.11.14",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "tsx": "4.19.4",
    "typescript": "5.7.3",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "wrangler": "4.159.0"
  }
}
