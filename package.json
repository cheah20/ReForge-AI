{
  "name": "reforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ReForge AI — AI-Powered Legacy Web Modernization and Multilingual Form Assistance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "generate-fixtures": "npx tsx scripts/create-fixtures/encrypted.ts",
    "generate-fixture-cache": "npx tsx scripts/generate-fixture-cache.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.0",
    "libphonenumber-js": "1.11.14",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.4.1",
    "fast-check": "4.10.2",
    "tsx": "4.19.4",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "wrangler": "4.20.0"
  }
}
